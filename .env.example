# Environment Configuration Template
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control!

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# Database (optional - defaults to instance/silent_mood.db)
# DATABASE_PATH=/path/to/database.db

# Port (optional - defaults to 5000, Render will set this automatically)
# PORT=5000

# Production Settings
# For production deployment, set FLASK_ENV=production
# Render will automatically generate a secure SECRET_KEY
